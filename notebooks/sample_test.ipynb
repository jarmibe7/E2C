    "import torch\n",
    "import random\n",
    "\n",
    "buffer_size = 10\n",
    "batch_size = 5\n",
    "buffer = torch.arange(0, buffer_size)*10\n",
    "\n",
    "idx = random.sample(range(buffer_size), batch_size)\n",
    "print(torch.randint(0, buffer_size, (batch_size,)))\n",
    "print(torch.randperm(buffer_size))\n",
    "print(idx)\n",
    "print(buffer[idx])"
   ]
  }
